# RateQ Mobile
# Production (DigitalOcean):
EXPO_PUBLIC_API_URL=https://api.rateq.qa/api/v1

# Local API (optional):
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Android emulator: http://10.0.2.2:4000/api/v1
# iOS simulator: http://localhost:4000/api/v1
# Physical device + local API: your machine LAN IP, e.g. http://192.168.1.10:4000/api/v1

# Firebase (same project as web)
# Enable Phone authentication in Firebase Console for SMS OTP verification.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (OAuth client IDs from Firebase / Google Cloud Console)
# WEB client ID is required (idToken for Firebase). Android/iOS clients must match package
# com.rateq.app; register the EAS/debug SHA-1 on the Android OAuth client / Firebase Android app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public website origin used when sharing company/project links
EXPO_PUBLIC_WEB_URL=https://www.rateq.qa

# Google Maps (required for Android map tiles in development / store builds).
# Enable "Maps SDK for Android" (and iOS if needed) in Google Cloud, restrict the
# key to package com.rateq.app + your EAS Android keystore SHA-1, then rebuild.
# Expo dashboard → Project → Credentials → Android → SHA-1 Certificate Fingerprint
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Apple Sign-In: enable Apple provider in Firebase Console and add Sign in with Apple
# capability to com.rateq.app in Apple Developer. iOS only in the mobile app.

# Used by EAS Build upload. When present, this file replaces .gitignore for
# what gets packed — keep it aggressive so monorepo junk is not uploaded.
# Local GoogleService-* files are gitignored but intentionally NOT listed here
# so `eas build` from a machine that has them still includes them. Prefer
# EAS file env vars (GOOGLE_SERVICES_JSON / GOOGLE_SERVICES_PLIST) for CI.

# Dependencies & package manager caches
node_modules
.pnp
.pnp.js
.pnpm-store

# VCS (EAS does not need the full git history in the archive)
.git

# Build outputs
dist
build
.next
out
.expo
.turbo
*.tsbuildinfo
apps/web/.next
apps/api/dist
apps/api/coverage

# Web app source/assets are not needed for the mobile native build
apps/web/src
apps/web/public
apps/web/.turbo
apps/web/.env
apps/web/.env.local

# API source/tests/prisma not needed for mobile JS bundle / prebuild
apps/api/src
apps/api/test
apps/api/prisma
apps/api/.env
apps/api/.env.local

# Environment — include project .env for Maps / Expo public config on EAS
.env.local
.env.*.local
!.env
!apps/mobile/.env
!.env.example

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output

# IDE / OS
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
.cursor

# Mobile native dirs (generated on EAS)
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android
*.jks
*.p8
*.p12
*.mobileprovision

# Docker / misc
.docker
*.pem
.cache
.vercel
rateq-theme-export/
docs/
.cursor-homepage-figma.png
